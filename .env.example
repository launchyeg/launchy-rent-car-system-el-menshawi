# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API). Never commit the real .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Push notifications — the public half of the VAPID key pair (safe to
# ship to the browser; the private half is an Edge Function secret, never
# here). Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
